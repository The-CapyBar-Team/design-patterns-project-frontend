@page "/"
@using System.Globalization
@using ClientBlazor.Models
@using ClientBlazor.Services
<PageTitle>Store Products</PageTitle>
@inject CartService CartService
@inject SessionService SessionService
@inject ProductService ProductService

<div class="container-fluid mt-4">
    <h1 class="mb-4">Products</h1>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" style="max-height: 80vh; overflow-y: auto;">
        @foreach (var product in products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
                        <span class="bi bi-cart-fill" aria-hidden="true" style="font-size:50px;"></span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted">@product.Description</p>
                        <p class="mt-auto fw-bold">@product.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</p>
                        <button class="btn btn-primary w-100 mt-2"
                                @onclick="@(() => AddToCart(product))"
                                disabled="@IsInCart(product)">
                                @((IsInCart(product)) ? "Already in Cart" : "Add to cart")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@code {
    private List<Product> products = new List<Product>();

    private string _sessionId;

    protected override void OnInitialized()
    {
        _sessionId = SessionService.GetOrCreateSessionId();
        CartService.OnChange += OnCartChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetProductsAsync();
    }
    private async Task AddToCart(Product product)
    {
        await CartService.RequestAddToCartAsync(product);
    }
    private bool IsInCart(Product product)
    {
        if (CartService.CartItems == null)
            return false;
        return CartService.CartItems.Any(item => item.Product.Id == product.Id);
    }

    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }
}