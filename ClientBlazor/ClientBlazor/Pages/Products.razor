@page "/products"
@using System.Globalization
@using ClientBlazor.Models
@using ClientBlazor.Services
<PageTitle>Store Products</PageTitle>
@inject CartService CartService
@inject SessionService SessionService
@inject ProductService ProductService

<div class="container mt-4">
    <h2 class="mb-4">Products</h2>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" style="max-height: 80vh; overflow-y: auto;">
        @foreach (var product in products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
                        <span class="bi bi-cart-fill" aria-hidden="true" style="font-size:50px;"></span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted">@product.Description</p>
                        <p class="mt-auto fw-bold">@product.Price.ToString("C", CultureInfo.CurrentCulture)</p>
                        <button class="btn btn-primary w-100 mt-2" @onclick="@(() => AddToCart(product))">Add to cart</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@code {
    private List<Product> products = new List<Product>();
    // {
    //     new Product(1, "Product A", "Description for A", 9.99f, 10),
    //     new Product(2, "Product B", "Description for B", 19.99f, 5),
    //     new Product(3, "Product C", "Description for C", 14.49f, 0),
    //     new Product(4, "Product D", "Description for D", 5.75f, 8),
    //     new Product(5, "Product E", "Description for E", 25.00f, 0),
    //     new Product(6, "Product F", "Description for F", 7.80f, 15),
    //     new Product(7, "Product G", "Description for G", 12.00f, 3),
    //     new Product(8, "Product H", "Description for H", 30.00f, 7)
    // };
    private string _sessionId;

    protected override void OnInitialized()
    {
        _sessionId = SessionService.GetOrCreateSessionId();
    }

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetProductsAsync();
    }
    private async Task AddToCart(Product product)
    {
     //   await CartService.AddToCartAsync(product);
    }
}